# LCONF_VERSION is increased each time build/conf/bblayers.conf changes incompatibly
LCONF_VERSION = "7"

BBPATH = "${TOPDIR}"
BBFILES ?= ""

# ##OEROOT## resolves to the openembedded-core root (vm-images/oe-core).
# meta-yocto is a sibling repo (vm-images/meta-yocto).
BBLAYERS ?= " \
  ##OEROOT##/meta \
  ##OEROOT##/../meta-yocto/meta-poky \
  ##OEROOT##/../meta-yocto/meta-yocto-bsp \
  "
